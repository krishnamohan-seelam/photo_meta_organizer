  "cards": [
    {
      "dot": "cyan",
      "title": "Clean Architecture & Ports/Adapters",
      "items": [
        "Domain layer remains pure Python with zero external dependencies",
        "Protocol interfaces (ImageRetriever, Extractor, Repository) decoupled from concrete adapters",
        "FastAPI REST layer maps web requests to application use cases"
      ]
    },
    {
      "dot": "emerald",
      "title": "High-Throughput Parallel Ingestion",
      "items": [
        "ParallelIndexPhotosUseCase uses ThreadPoolExecutor (21,700+ images/min)",
        "Bounded Queue routes serialized metadata to single DB writer thread for TinyDB thread-safety",
        "Stateless metadata extractor parses EXIF tags and computes MD5/SHA256 file hashes"
      ]
    },
    {
      "dot": "rose",
      "title": "Storage & Performance Optimizations",
      "items": [
        "In-Memory TinyDB indexes maintain O(1) hash lookups and sorted timestamp/size ranges",
        "On-the-fly WebP thumbnail streaming with Pillow LANCZOS resampling & disk caching",
        "React 19 virtualized studio gallery UI for smooth navigation of 50,000+ photo collections"
      ]
    }
  ]
